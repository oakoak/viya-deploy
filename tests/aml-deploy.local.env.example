# Шаблон aml-deploy.local.env — реквизиты Viya для ЛОКАЛЬНОГО прогона API-тестов (tests/api/).
#
# Скопируйте в aml-deploy.local.env (рядом) и заполните значениями тестового/дев Viya. Реальный
# файл aml-deploy.local.env в git НЕ попадает (см. .gitignore) — это секреты. API-тесты авто-скипаются,
# если файла нет или он неполный, поэтому CI/юнит-прогон остаётся зелёным без него.
#
# Формат — тот же, что у боевого custom_config/aml-deploy.env (KEY=VALUE).
# Тесты создают и удаляют объекты ТОЛЬКО в выделенной scratch-папке
# /Environment/__aml_deploy_tests_<uid> и подчищают за собой.

AML_DEPLOY_VIYA_TENANT=
AML_DEPLOY_VIYA_HOST=
AML_DEPLOY_VIYA_USER=
AML_DEPLOY_VIYA_PASSWORD=
